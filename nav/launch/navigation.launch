<launch>
  <!-- ===== Args ===== -->
  <arg name="odom_frame_id"   default="odom"/>
  <arg name="scan_topic"      default="scan"/>
  <arg name="base_frame_id"   default="base_footprint"/>
  <arg name="global_frame_id" default="map"/>
  <arg name="odom_topic"      default="odom"/>
  <arg name="laser_topic"     default="scan"/>     <!-- kept for compatibility -->
  <arg name="map_name"        default="map"/>
  <arg name="use_map_topic"   default="false"/>
  <arg name="initial_pose_x"  default="0.0"/>
  <arg name="initial_pose_y"  default="0.0"/>
  <arg name="initial_pose_a"  default="0.0"/>

  <!-- ===== TFs ===== -->
  <!-- DO NOT publish map->odom; AMCL owns it -->
  <!-- Laser TF (put real numbers as needed) -->
  <node pkg="tf" type="static_transform_publisher" name="baselink_to_laser"
        args="0 0 0 0 0 0 $(arg base_frame_id) laser 100" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_odom"
        args="0 0 0 0 0 0 map odom" />
<!-- ===== Map first ===== -->
  <node pkg="map_server" type="map_server" name="map_server"
        args="$(find nav)/$(arg map_name).yaml" />

  <!-- ===== move_base ===== -->
  <node pkg="move_base" type="move_base" name="move_base" respawn="true" output="screen">
    <!-- Load parameters -->
    <rosparam file="$(find nav)/nav_params/costmap_common_params.yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(find nav)/nav_params/costmap_common_params.yaml" command="load" ns="local_costmap"/>
    <rosparam file="$(find nav)/nav_params/local_costmap_params.yaml"  command="load"/>
    <rosparam file="$(find nav)/nav_params/global_costmap_params.yaml" command="load"/>
    <rosparam file="$(find nav)/nav_params/dwa_local_planner_params.yaml" command="load"/>
    <rosparam file="$(find nav)/nav_params/move_base_params.yaml" command="load"/>
    <!-- Pick ONE global planner set; comment out the one you don’t use -->
    <rosparam file="$(find nav)/nav_params/global_planner_params.yaml"   command="load"/>
    <!-- <rosparam file="$(find nav)/nav_params/navfn_global_planner_params.yaml" command="load"/> -->
    <!-- Optional extras (only if used elsewhere) -->
    <!-- <rosparam file="$(find nav)/nav_params/controllers.yaml" command="load"/> -->
    <!-- <rosparam file="$(find nav)/nav_params/joint_limits.yaml" command="load"/> -->

    <!-- Frame overrides (ensure consistency with args) -->
    <param name="global_costmap/global_frame" value="$(arg global_frame_id)"/>
    <param name="global_costmap/robot_base_frame" value="$(arg base_frame_id)"/>
    <param name="local_costmap/global_frame" value="$(arg odom_frame_id)"/>
    <param name="local_costmap/robot_base_frame" value="$(arg base_frame_id)"/>
    <param name="DWAPlannerROS/global_frame_id" value="$(arg odom_frame_id)"/>

    <!-- Topic remaps -->
    <remap from="odom" to="$(arg odom_topic)"/>
    <remap from="scan" to="$(arg scan_topic)"/>
    <remap from="cmd_vel" to="/mobile_base/commands/velocity"/>
  </node>

  <!-- ===== AMCL (publishes map->odom) ===== -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <!-- Load all tuning from YAML -->
    <rosparam file="$(find nav)/nav_params/amcl_params.yaml" command="load"/>

    <!-- Minimal runtime overrides -->
    <param name="odom_frame_id" value="$(arg odom_frame_id)"/>
    <param name="base_frame_id" value="$(arg base_frame_id)"/>
    <param name="use_map_topic" value="$(arg use_map_topic)"/>
    <param name="initial_pose_x" value="$(arg initial_pose_x)"/>
    <param name="initial_pose_y" value="$(arg initial_pose_y)"/>
    <param name="initial_pose_a" value="$(arg initial_pose_a)"/>

    <remap from="scan" to="$(arg scan_topic)"/>
  </node>

  <!-- ===== RViz ===== -->
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find nav)/rviz/nav.rviz" />
</launch>
